# =============================================================================
# .env.example - Variáveis de Ambiente para RabbitMQ
# =============================================================================
# Copie este arquivo para .env e configure as variáveis conforme necessário:
#   cp .env.example .env
#   nano .env
# =============================================================================

# -----------------------------------------------------------------------------
# Configurações do RabbitMQ - OBRIGATÓRIAS
# -----------------------------------------------------------------------------

# Nome de usuário padrão para acesso ao RabbitMQ Management UI e conexões AMQP
# Este usuário será criado automaticamente na primeira inicialização
# IMPORTANTE: Altere para um usuário seguro em produção!
RABBITMQ_DEFAULT_USER=admin

# Senha padrão para o usuário acima
# IMPORTANTE: Altere para uma senha forte em produção!
# A senha deve ser segura e não deve conter caracteres especiais que possam
# causar problemas no shell (evite: $, `, ", ', \, etc.)
RABBITMQ_DEFAULT_PASS=secret

# Virtual Host padrão no RabbitMQ
# O virtual host é uma forma de segmentar diferentes ambientes ou aplicações
# dentro do mesmo servidor RabbitMQ. O valor "/" é o vhost padrão.
# Exemplos: "/", "/dev", "/prod", "/app1"
RABBITMQ_DEFAULT_VHOST=/

# Cookie Erlang para clustering
# Usado para autenticação entre nós em um cluster RabbitMQ
# IMPORTANTE: Todos os nós do cluster devem ter o mesmo cookie
# Deve ser uma string alfanumérica (sem espaços ou caracteres especiais)
# IMPORTANTE: Mantenha este valor secreto e seguro!
RABBITMQ_ERLANG_COOKIE=secret_cookie

# -----------------------------------------------------------------------------
# Configurações do Docker Swarm Stack - OPCIONAIS
# -----------------------------------------------------------------------------

# Nome da stack Docker Swarm
# Se não definido, será usado o nome do serviço no docker-compose.yml
# Útil quando você precisa rodar múltiplas instâncias do RabbitMQ
# Exemplo: STACK_NAME=rabbitmq-dev
STACK_NAME=rabbitmq

# -----------------------------------------------------------------------------
# Notas Importantes
# -----------------------------------------------------------------------------
# 
# 1. SEGURANÇA:
#    - NUNCA commite o arquivo .env no Git (ele está no .gitignore)
#    - Use senhas fortes em produção
#    - O RABBITMQ_ERLANG_COOKIE deve ser mantido secreto
#
# 2. PERSISTÊNCIA:
#    - Os dados são armazenados em: ./rabbit_data/
#    - Os logs são armazenados em: ./rabbit_logs/
#    - As definições (filas, exchanges, etc.) estão em: ./rabbit_definitions/
#
# 3. REDES:
#    - O RabbitMQ se conecta às redes: rabbitmq_network, shared_dev_net, net_nginx_pm
#    - Essas redes devem existir antes de iniciar a stack
#    - O script start_stack.sh cria automaticamente se não existirem
#
# 4. ACESSO:
#    - Management UI: http://localhost:15672 (se portas estiverem expostas)
#    - AMQP Port: 5672 (se portas estiverem expostas)
#    - Por padrão, as portas NÃO estão expostas (acesso apenas via redes Docker)
#
# 5. DEFINITIONS.JSON:
#    - O arquivo rabbit_definitions/definitions.json é carregado automaticamente
#    - Ele contém usuários, vhosts, filas, exchanges e políticas pré-configuradas
#    - Se você modificar o usuário/senha aqui, atualize também o definitions.json
